# ==============================================================================
# Environment Configuration - Rural Public Healthcare MVP
# ==============================================================================

# 1. Database Connection Strings (Server-side only, consumed by Prisma)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require"
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require"

# 2. Supabase Auth Configuration
# Public Supabase project URL (used by both client and server)
NEXT_PUBLIC_SUPABASE_URL="https://<YOUR_PROJECT_REF>.supabase.co"

# Public anonymous key for client-side authentication requests
NEXT_PUBLIC_SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_KEY>"

# Server-side Supabase Service Role Key (SERVER-SIDE ONLY — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_KEY>"

# Server-side JWT Secret for token verification (SERVER-SIDE ONLY)
SUPABASE_JWT_SECRET="<YOUR_SUPABASE_JWT_SECRET>"

# 3. Node Environment
NODE_ENV="development"

# 4. Production SMS / OTP Provider Configuration (MSG91 / DLT)
# Mandatory for production patient SMS/OTP authentication.
# Keep secrets in deployment platform environment variables / secret manager only.
PATIENT_OTP_PROVIDER="MSG91"
PATIENT_OTP_API_KEY="<ACTUAL_MSG91_AUTH_KEY>"
PATIENT_OTP_SENDER_ID="<ACTUAL_DLT_SENDER_ID>"
PATIENT_OTP_TEMPLATE_ID="<ACTUAL_DLT_TEMPLATE_ID>"
